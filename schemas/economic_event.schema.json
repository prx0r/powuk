{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POW EconomicEvent",
  "type": "object",
  "required": [
    "event_id",
    "garden",
    "event_type",
    "observed_at",
    "entity_ids",
    "confidence",
    "source_ids",
    "rights"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "garden": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "direction": {
      "enum": [
        "up",
        "down",
        "mixed",
        "neutral",
        null
      ]
    },
    "magnitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    }
  },
  "additionalProperties": false
}